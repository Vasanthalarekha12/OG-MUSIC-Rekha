rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & personal subcollections
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /playCounts/{songId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Listening Rooms (Real-time synchronized playback sessions)
    match /listeningRooms/{roomId} {
      // Room can be read by authenticated users
      allow read: if isAuthenticated();

      // Only authenticated user can create a room as host
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;

      // Update rules:
      // Host can update entire playback state, queue, and participants
      // Participants can only update their own heartbeat or remove themselves
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        (
          // Participant updating own heartbeat
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.playbackState == resource.data.playbackState &&
          request.resource.data.currentTrack == resource.data.currentTrack
        )
      );

      // Only host can delete / end room
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }

    // Room Invitations (Secure tokens generated by host)
    match /roomInvitations/{inviteToken} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }

    // Room Join Requests (Guest requests admission to room)
    match /roomJoinRequests/{requestId} {
      // Requester and Host can read the request
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostId == request.auth.uid
      );

      // Authenticated guest can create a pending request for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Only the host can accept or reject the request
      allow update: if isAuthenticated() &&
        resource.data.hostId == request.auth.uid &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected');

      // Cleanup
      allow delete: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Friendships (Permanent accepted friendships)
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.users;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.users;
    }
  }
}
